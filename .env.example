# 이 파일을 .env.local로 복사해서 쓴다 (cp .env.example .env.local).
# .env.local은 git에 올라가지 않는다. 값이 없으면 그 기능만 조용히 꺼진다.
#
# 고친 뒤에는 앱을 다시 띄워야 반영된다.

# ---- 필수에 가까운 것 ----

# /admin 열쇠. 비워 두면 아무도 못 들어간다(그게 기본값이다).
ADMIN_TOKEN=

# 사이트의 절대 주소. 도메인이 정해지면 여기에 박는다.
# 비워 두면 요청이 들어온 호스트에서 만든다 — 터널 주소로 열어도 OG 카드가 뜬다.
APP_ORIGIN=

# SQLite 파일 경로. 비워 두면 <앱을 띄운 폴더>/data/storyteller.sqlite 다.
# 건드리지 않는 게 좋다 — 여기를 잘못 적으면 빈 DB가 새로 생기고
# 그동안 쌓인 기록이 안 보인다. npm run db:where 로 확인할 수 있다.
STORYTELLER_DB=

# ---- 공개 페이지에 노출되는 것 ----

# /about과 /privacy에 그대로 찍힌다. 비워 두면 "준비 중입니다"로 나온다.
# 광고 심사는 연락할 곳이 있는지를 본다.
CONTACT_EMAIL=

# ---- 광고 ----

# 애드센스 → 계정 → 설정 → 계정 정보에 있는 퍼블리셔 ID.
# 형식: pub-0000000000000000   (ca-는 붙이지 않는다. 코드가 알아서 붙인다)
#
# 이 하나로 두 가지가 켜진다:
#   - <head>의 애드센스 스크립트 (검토를 걸려면 있어야 한다)
#   - /ads.txt        (비워 두면 404다 — 빈 ads.txt보다 없는 게 낫다)
ADSENSE_PUBLISHER_ID=

# 애드핏도 같이 붙일 때, 카카오가 주는 ads.txt 한 줄을 그대로 넣는다.
ADFIT_ADS_TXT=
