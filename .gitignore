node_modules/
.next/
# 맨 앞의 / 가 중요하다. 이게 없으면 어느 깊이의 out 폴더든 다 걸린다 —
# 실제로 app/api/out/route.ts 가 이것 때문에 커밋되지 않고 사라졌다.
/out/
*.tsbuildinfo
next-env.d.ts

# 파생물 — md/json에서 빌드된다
content/.build/

# 로컬 DB
data/
*.sqlite
*.sqlite-journal

# 파생물 — npm run preview로 다시 뽑는다
preview/

# 비밀이 든다. 절대 커밋되면 안 된다 — ADMIN_TOKEN이 여기 있다.
.env*.local

# 맥이 폴더마다 만들어 두는 것. 레포에 들어갈 이유가 없다.
.DS_Store
