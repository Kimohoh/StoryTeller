<?xml version="1.0" encoding="UTF-8"?>
<!--
  앱을 맥이 켜지면 저절로 뜨고, 죽으면 저절로 살아나는 서비스로 만든다.

  터미널 창을 띄워 두는 방식은 창을 실수로 닫거나 맥이 재부팅되면 끝이다.
  광고 심사 크롤러는 며칠에 걸쳐 아무 때나 오기 때문에, 그 사이 한 번
  꺼져 있으면 그것만으로 반려된다.

  이 파일은 본이다. 손으로 고쳐 쓰지 말고 레포 폴더에서 이걸 돌린다:

    npm run launchd:install

  __REPO__ 는 지금 폴더로, __NPM__ 과 __PATH__ 는 이 맥에 실제로 깔린
  경로로 채워서 ~/Library/LaunchAgents/ 에 넣고 다시 띄운다. 편집기로
  고치다 한 줄이 지워지면 launchd가 / 에서 앱을 띄우려 들고, 그러면
  package.json을 못 찾는다며 조용히 죽는다.

  끄려면: launchctl unload ~/Library/LaunchAgents/page.godok.app.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>page.godok.app</string>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <!-- launchd는 로그인 셸이 아니라서 PATH가 비어 있다. brew 경로를 직접 준다.

       APP_ORIGIN, ADMIN_TOKEN, ADSENSE_PUBLISHER_ID 같은 값은 여기 적지 않는다.
       레포 폴더의 .env.local에 두면 Next가 뜰 때 알아서 읽는다 — 비밀이
       LaunchAgents 폴더로 복사되지 않고, 값을 고칠 때 이 파일을 건드릴 일도 없다. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>

  <key>ProgramArguments</key>
  <array>
    <string>__NPM__</string>
    <string>start</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <!-- 죽으면 다시 띄운다 -->
  <key>KeepAlive</key>
  <true/>
  <!-- 죽자마자 무한 재시작하지 않도록 10초 쉰다 -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/tmp/godok-app.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/godok-app.err.log</string>
</dict>
</plist>
