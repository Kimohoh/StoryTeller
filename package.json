{
  "name": "storyteller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run content:build && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "content:build": "tsx scripts/build-content.ts",
    "content:check": "tsx scripts/build-content.ts --check",
    "db:seed": "tsx scripts/seed.ts",
    "db:rescore": "tsx scripts/rescore.ts",
    "test": "node --import tsx --test scripts/*.test.ts",
    "preview": "tsx scripts/build-preview.ts",
    "illustration": "tsx scripts/replace-illustration.ts",
    "brief": "tsx scripts/build-brief-page.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
